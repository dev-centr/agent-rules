// Product company / commercial org. Same public surfaces as oss-collective, plus mail/infra when a domain exists.
profile "product-org" {
	kind "org"
	summary "Product org: hub + docs + separate product hostname; email lanes when in scope."

	session_scope "identity" "site" "docs" "news-blog" "email" "infra"

	site {
		framework "solidstart"
		ui "solid-ui"
		preset "static"
		ssr false
		host "github-pages"
		repo "{org}.github.io"
		product_host "separate-from-org-hub"
	}

	docs {
		generator "antora"
		theme "valentus"
		pin "v2"
		repo "docs"
	}

	email {
		inbound "cloudflare-routing"
		human "zeptomail"
		product "resend"
		product_host "updates."
		marketing "customerio-when-journeys"
		apex "do-not-mix-lanes"
	}

	infra {
		repo "infra"
		tool "pulumi"
		language "typescript"
	}

	skip "self-host-chat" "github-private"
}
