// Docs-first org. Thin or skipped marketing site; one Antora hub is the public face.
profile "docs-hub" {
	kind "org"
	summary "Docs-first: Antora + Valentus is the public site. Do not generate a marketing site when a homepage is imported."

	session_scope "identity" "docs"

	site {
		optional true
		framework "solidstart"
		ui "solid-ui"
		preset "static"
		ssr false
		host "github-pages"
		role "skip-when-homepage-imported"
	}

	docs {
		generator "antora"
		theme "valentus"
		pin "v2"
		repo "docs"
		public_face true
		math true
	}

	skip "news-until-newsworthy" "email" "infra" "github-private"
}
